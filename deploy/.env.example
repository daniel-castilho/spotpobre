# Spotpobre API — production environment contract (on-premises bare metal, ADR-0002).
#
# Copy to deploy/.env and fill in the secret values. deploy/.env is gitignored and must
# never be committed. The prod profile fail-fast validator (ProdConfigValidator) refuses
# to boot if anything required is missing or incoherent.
#
#   cp deploy/.env.example deploy/.env
#   JWT_SECRET="$(openssl rand -base64 48)"   # then paste into .env

# --- Runtime profile -----------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod

# --- Secrets (NEVER commit real values) ----------------------------------------------
# Strong random secret, e.g. openssl rand -base64 48. Rotating it invalidates all
# issued tokens (users must log in again).
JWT_SECRET=change-me-openssl-rand-base64-48

# --- AWS credential source (ADR-0002) ------------------------------------------------
# static             -> on-premises LocalStack target: dummy keys REQUIRED below.
# workload-identity  -> real AWS target (ADR-0001 path): leave the two keys UNSET.
AWS_CREDENTIALS_SOURCE=static
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- AWS endpoints (LocalStack on the same host) --------------------------------------
AWS_REGION=us-east-1
AWS_DYNAMODB_ENDPOINT=http://localstack:4566
AWS_S3_ENDPOINT=http://localstack:4566
AWS_S3_BUCKET_NAME=spotpobre-songs

# --- Redis (auth cache) ---------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# --- Outbound e-mail (SES via LocalStack; REQUIRED) -------------------------------------
# The address must be a verified SES identity (seed-localstack.sh verifies it on seed).
EMAIL_FROM_ADDRESS=no-reply@spotpobre.local
EMAIL_SES_ENDPOINT=http://localstack:4566

# --- Rate limiting (REQUIRED secret; bounded policy defaults) --------------------------
# Generate: RATE_LIMIT_KEY_SECRET="$(openssl rand -base64 48)"
# Must differ from JWT_SECRET. Subject keys are HMAC'd with it before touching Redis.
RATE_LIMIT_KEY_SECRET=change-me-openssl-rand-base64-48
# Optional per-policy tuning (spec section 8.3 table):
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REGISTER_IP_CAPACITY=20
# RATE_LIMIT_REGISTER_EMAIL_CAPACITY=5
# RATE_LIMIT_AUTHENTICATE_IP_CAPACITY=100
# RATE_LIMIT_AUTHENTICATE_EMAIL_CAPACITY=10
# RATE_LIMIT_UPLOAD_INITIATE_USER_CAPACITY=20
# RATE_LIMIT_UPLOAD_INITIATE_ALBUM_CAPACITY=40
# RATE_LIMIT_UPLOAD_CONFIRM_USER_CAPACITY=60
# RATE_LIMIT_UPLOAD_CONFIRM_ALBUM_CAPACITY=120
# RATE_LIMIT_SEARCH_CAPACITY=120
# Trusted proxies allowed to set X-Forwarded-For/Forwarded (never trust the world):
# RATE_LIMIT_TRUSTED_PROXY_CIDRS=10.0.0.0/8

# --- Deployment images (optional overrides used by the compose file) -------------------
# IMAGE_BLUE=spotpobre-api:local
# IMAGE_GREEN=spotpobre-api:local
